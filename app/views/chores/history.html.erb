<% content_for :header_title do %>
  <div class="header-title-with-icon">
     <%= image_tag "アイアンマン.png", class: "header-icon" %>
     履歴
  </div>
<% end %><br>

<% if @chore_dates.any? { |cd| cd.chore_histories.exists? } %>
  <div class="chore-list-history">

    <div class="chore-row-header chore-header">
      <div class="chore-title-header-chores-history">家事名</div>
      <div class="chore-reward-header-chores-history">報酬</div>
      <div class="chore-date-header-chores-history">日時</div>
      <div class="chore-user-header-chores-history">実施者</div>
    </div>

    <% @chore_dates.each do |chore_date| %>
      <% chore = chore_date.chore %>
      <% histories = chore_date.chore_histories.order(done_at: :desc) %>
      <% next if histories.empty? %>

      <div class="chore-row">

        <!-- 左：カテゴリ＋タイトル -->
        <div class="chore-main">

          <!-- 丸アイコン -->
          <div class="chore-icon">
            <%= image_tag chore.category.stamp, class: "category-icon-home" %>
          </div>

          <!-- テキスト -->
          <div class="chore-text">
            <span class="category-badge"
                  style="background-color: <%= chore.category.color %>;">
              <%= chore.category.name %>
            </span>

            <div class="chore-title">
              <%= chore.title %>
            </div>
          </div>

        </div>

        <!-- 中央：報酬 -->
        <div class="chore-reward-area">
          <div class="reward-button">
            スタンプ <%= chore.stamp_reward %> 個
          </div>
        </div>

        <!-- 完了日時（代表者） -->
        <div class="chore-time-area">
          <% first_history = histories.first %>
          <span class="chore-date">
            <%= first_history.done_at.strftime("%-m/%-d") %>(<%= %w[日 月 火 水 木 金 土][first_history.done_at.wday] %>)
          </span><br>
          <span class="chore-time">
            <%= first_history.done_at.in_time_zone("Tokyo").strftime("%H:%M") %>
          </span>
        </div>

        <!-- 実施者アイコン -->
        <div class="chore-user-area">
          <% if histories.size >= 3 %>
            <%= image_tag "group.png", class: "user-avatar-history" %>
          <% else %>
            <% histories.each do |h| %>
              <% if h.user&.avatar_image&.attached? %>
                <%= image_tag h.user.avatar_image, class: "user-avatar-history" %>
              <% else %>
                <%= image_tag "default_avatar.png", class: "user-avatar-history" %>
              <% end %>
            <% end %>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>
<% else %>
  <p class="no-chore-message">まだ家事の履歴はありません</p>
<% end %>