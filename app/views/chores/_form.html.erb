<%= form_with model: @chore, local: true do |f| %>

  <div>
    <%= f.label :title, "家事名" %><br>
    <%= f.text_field :title %>
  </div><br>

  <div>
    <%= f.label :cake_reward, "報酬" %><br>
    <%= f.number_field :cake_reward, min: 1 %>
  </div><br>

  <div>
    <%= f.label :execute_dates, "実行日" %><br>

    <button
      type="button"
      id="open-calendar-btn"
      data-has-dates="<%= @chore.chore_dates.any? %>">
      <%= @chore.chore_dates.any? ?
            "実行日を変更する" :
            "クリックして日付を選択" %>
    </button>

    <%= f.text_field :execute_dates,
      id: "execute_dates",
      class: "hidden-calendar-input",
      value: @chore.chore_dates
                    .order(:execute_at)
                    .map { |cd| cd.execute_date }
                    .join(",") %>
  </div><br>

  <div>
    <%= f.label :execute_time, "実行時間" %><br>
    <%= f.time_field :execute_time,
      value: @chore.chore_dates.first&.execute_time %>
  </div><br>

  <div>
    <%= f.label :detail, "家事の詳細" %><br>
    <%= f.text_area :detail, rows: 4 %>
  </div><br>

  <div class="fixed-bottom-right">
    <%= f.submit (local_assigns[:submit_label] || "登録"),
          class: "fixed-btn" %>

    <%= link_to (local_assigns[:back_label] || "戻る"),
          (local_assigns[:back_path] || chores_path),
          class: "fixed-link" %>
  </div>

<% end %>
