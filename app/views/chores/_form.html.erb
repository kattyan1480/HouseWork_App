<%= form_with model: @chore, local: true do |f| %>

  <div class="field">
    <%= f.label :title, "家事名" %>
    <%= f.text_field :title,
          placeholder: "例：洗濯、皿洗い" %>
  </div>

  <div class="field">
    <%= f.label :cake_reward, "報酬" %>
    <%= f.number_field :cake_reward,
          min: 1,
          placeholder: "ケーキの数を入力する" %>
  </div>

  <div class="field">
    <%= f.label :execute_dates, "実行日" %>

    <button
      type="button"
      id="open-calendar-btn"
      data-has-dates="<%= @pending_chore_dates.any? %>">
      <%= @pending_chore_dates.any? ?
            "実行日を変更する" :
            "クリックして日付を選択" %>
    </button>

    <%= f.text_field :execute_dates,
          id: "execute_dates",
          class: "hidden-calendar-input",
          value: @pending_chore_dates
                    .order(:execute_at)
                    .map { |cd| cd.execute_date }
                    .join(","),
          placeholder: "日付を選択してください" %>
  </div>

  <div>
    <%= f.label :execute_time, "実行時間" %><br>
    <%= f.time_field :execute_time,
          value: @pending_chore_dates.first&.execute_time %>
  </div><br>

  <div class="field">
    <%= f.label :detail, "備考" %>
    <%= f.text_area :detail,
          rows: 4,
          placeholder: "詳細があれば入力してください" %>
  </div>

  <div class="fixed-bottom-right">
    <%= f.submit (local_assigns[:submit_label] || "登録"),
          class: "fixed-btn" %>

    <%= link_to (local_assigns[:back_label] || "戻る"),
          (local_assigns[:back_path] || chores_path),
          class: "fixed-link" %>
  </div>

<% end %>