<%= form_with model: @chore,
              local: true,
              data: { turbo: false },
              class: "form-wrapper-chore" do |f| %>
    
  <div class="form-card">

    <!-- カテゴリ -->
    <div class="form-group">
      <div class="label-row">
        <%= f.label :category_id, "カテゴリ", class: "form-label" %>
        <span class="required">必須</span>
      </div>

      <%= f.collection_select :category_id,
            current_user.group.categories,
            :id,
            :name,
            { prompt: "カテゴリを選択してください" },
            class: "form-input #{'input-error' if @chore.errors[:category].any?}" %>

      <% if @chore.errors[:category].any? %>
        <div class="field-error-message">
          <%= @chore.errors.full_messages_for(:category).first %>
        </div>
      <% end %>
    </div>

    <!-- 家事名 -->
    <div class="form-group">
      <div class="label-row">
        <%= f.label :title, "家事名", class: "form-label" %>
        <span class="required">必須</span>
      </div>

      <%= f.text_field :title,
            class: "form-input #{'input-error' if @chore.errors[:title].any?}",
            placeholder: "例）朝ごはん、洗濯物干し" %>

      <% if @chore.errors[:title].any? %>
        <div class="field-error-message">
          <%= @chore.errors.full_messages_for(:title).first %>
        </div>
      <% end %>
    </div>

    <!-- 報酬 -->
    <div class="form-group">
      <div class="label-row">
        <%= f.label :stamp_reward, "貰えるスタンプの数", class: "form-label" %>
        <span class="required">必須</span>
      </div>

      <%= f.number_field :stamp_reward,
            min: 1,
            class: "form-input #{'input-error' if @chore.errors[:stamp_reward].any?}",
            placeholder: "スタンプの数を入力してください" %>

      <% if @chore.errors[:stamp_reward].any? %>
        <div class="field-error-message">
          <%= @chore.errors.full_messages_for(:stamp_reward).first %>
        </div>
      <% end %>
    </div>

    <!-- 実行日 -->
    <div class="form-group">
      <div class="label-row">
        <%= f.label :execute_dates, "実行日", class: "form-label" %>
        <span class="required">必須</span>
      </div>

      <% selected_dates =
           params.dig(:chore, :execute_dates) ||
           @pending_chore_dates&.order(:execute_at)
             &.map { |cd| cd.execute_date }
             &.join(",") %>

      <button
        type="button"
        id="open-calendar-btn"
        class="calendar-btn <%= 'input-error' if @chore.errors[:execute_dates].any? %>"
        data-has-dates="<%= selected_dates.present? %>">
        <%= selected_dates.present? ? "実行日を変更する" : "実行日を選択してください" %>
      </button>

      <%= f.text_field :execute_dates,
            id: "execute_dates",
            class: "hidden-calendar-input",
            value: selected_dates %>

      <% if @chore.errors[:execute_dates].any? %>
        <div class="field-error-message">
          <%= @chore.errors.full_messages_for(:execute_dates).first %>
        </div>
      <% end %>
    </div>

    <!-- 実行時間 -->
    <div class="form-group">
      <div class="label-row">
        <%= f.label :execute_time, "実行時間", class: "form-label" %>
        <span class="required">必須</span>
      </div>

      <% selected_time =
           params.dig(:chore, :execute_time) ||
           @pending_chore_dates&.first&.execute_time %>

      <%= f.time_field :execute_time,
            class: "form-input #{'input-error' if @chore.errors[:execute_time].any?}",
            value: selected_time %>

      <% if @chore.errors[:execute_time].any? %>
        <div class="field-error-message">
          <%= @chore.errors.full_messages_for(:execute_time).first %>
        </div>
      <% end %>
    </div>

    <!-- 備考 -->
    <div class="form-group">
      <div class="label-row">
        <%= f.label :detail, "メモ", class: "form-label" %>
      </div>

      <%= f.text_area :detail,
            rows: 4,
            class: "form-textarea #{'input-error' if @chore.errors[:detail].any?}",
            placeholder: "詳細があれば入力してください" %>

      <% if @chore.errors[:detail].any? %>
        <div class="field-error-message">
          <%= @chore.errors[:detail].first %>
        </div>
      <% end %>
    </div>

    <!-- ボタン -->
    <div class="form-actions">
      <%= f.submit (local_assigns[:submit_label] || "作成"),
            class: "submit-btn" %>

      <%= link_to (local_assigns[:back_label] || "キャンセル"),
            (local_assigns[:back_path] || chores_path),
            class: "back-link" %>
    </div>

  </div>
<% end %>