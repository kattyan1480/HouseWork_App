<% content_for :header_title do %>
  🧹 家事list
<% end %>

<h3>未完了の家事一覧</h3>

<div class="chore-list">
  <% @chores.each do |chore| %>
    <div class="chore-row">

      <div class="chore-title-detail">
        <span class="chore-title"><%= truncate(chore.title, length: 7) %></span>
        <span class="chore-detail">
          <%= truncate(chore.detail, length: 13) %>
        </span>
      </div>

      <div class="chore-cake-reward">
        <% reward = chore.cake_reward.to_i %>

        <% if reward <= 5 %>
          <% reward.times do %>
            <%= image_tag "shortcake.png", class: "cake-icon" %>
          <% end %>
        <% else %>
          <%= image_tag "shortcake.png", class: "cake-icon" %>
          <span class="cake-multiple">×<%= reward %></span>
        <% end %>
      </div>

      <div class="chore-actions">
        <%= link_to "詳細", edit_chore_path(chore), class: "edit-link" %>
        <%= link_to "削除",
                    chore_path(chore),
                    data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                    class: "delete-link" %>
      </div>
    </div>
  <% end %>
</div>