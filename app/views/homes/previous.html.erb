<% content_for :header_title do %>
  過去のやり残し
<% end %><br>

<% if @before_yesterday_chore_dates.any? %>
  <div class="chore-list-home">
    <% @before_yesterday_chore_dates.each do |chore_date| %>
      <% chore = chore_date.chore %>

      <div class="chore-row js-open-modal"
        data-chore-date-id="<%= chore_date.id %>"
        data-chore-title="<%= chore.title %>"
        data-chore-detail="<%= chore.detail %>">

        <div class="chore-title-detail">
          <span class="chore-title"><%= truncate(chore.title, length: 7) %></span>
          <span class="chore-detail">
            <%= truncate(chore.detail, length: 13) %>
          </span>
        </div>

        <div class="chore-cake-reward">
          <% reward = chore.cake_reward.to_i %>

          <% if reward <= 5 %>
            <% reward.times do %>
              <%= image_tag "shortcake.png", class: "cake-icon" %>
            <% end %>
          <% else %>
            <%= image_tag "shortcake.png", class: "cake-icon" %>
            <span class="cake-multiple">×<%= reward %></span>
          <% end %>
        </div>

        <div class="chore-actions-home">
          <span class="chore-time">
            <%= chore_date.execute_at.strftime("%H:%M") %>
          </span>
        </div>

      </div>
    <% end %>
  </div>
<% else %>
  <p>過去やり残した家事はありません</p>
<% end %>

<% content_for :fixed_ui_right do %>
  <%= link_to "戻る", homes_index_path, class: "fixed-link" %>
<% end %>

<%= render "popup" %>