<div id="chore-modal" class="modal hidden">
  <div class="modal-overlay"></div>

  <div class="modal-content">
    <!-- 家事タイトル -->
    <div class="modal-title-area">
      <span id="modal-chore-title" class="modal-chore-title"></span>

      <a id="modal-detail"
        href="#"
        data-turbo="true">
        <%= image_tag "詳細.png", class: "detail-icon-home" %>
      </a>
    </div>

    <!-- ===== 完了フォーム ===== -->
    <form action="<%= complete_chore_date_path('DUMMY') %>"
          method="post"
          id="complete-form"
          data-turbo="true">

      <!-- Rails用 CSRF -->
      <%= csrf_meta_tags %>

      <!-- chore_date の id を JS でセット -->
      <%= hidden_field_tag :id, "", id: "modal-chore-date-id" %>

      <!-- ★ 完了者選択 -->
      <div class="modal-members">

        <div class="member-select">

          <!-- 表示部分 -->
          <div class="member-select-header js-toggle-member">
            <span class="selected-text">完了者を選択</span>
            <span class="arrow">▼</span>
          </div>

          <!-- ドロップダウン -->
          <div class="member-select-dropdown">
            <% current_user.group.users.each do |user| %>
              <label class="member-checkbox">
                <input type="checkbox"
                      name="completed_user_ids[]"
                      value="<%= user.id %>">
                <span><%= user.name %></span>
              </label>
            <% end %>
          </div>
        </div>

        <!-- 完了ボタン -->
        <div class="modal-buttons">
          <div class="modal-buttons-complete">
            <button type="submit">完了</button>
          </div>
        </div>
      </div>
    </form>

    <!-- ===== リスケフォーム ===== -->
    <%= form_with url: reschedule_chore_dates_path,
                  method: :patch,
                  id: "reschedule-form",
                  local: true do %>

      <%= hidden_field_tag :id, "", id: "reschedule-id" %>

      <!-- カレンダー入力（非表示） -->
      <%= text_field_tag :execute_at, "",
            id: "reschedule-execute-at",
            class: "hidden-calendar-input-reschedule" %>

      <div class="modal-buttons-sub">
        <div class="modal-buttons-reschedule">
          <!-- カレンダー開くボタン -->
          <button id="modal-reschedule" type="button">リスケ</button>

          <!-- 送信ボタンは常に submit -->
          <button id="modal-reschedule-submit" type="submit" disabled>変更する</button>
        </div>
      </div>

    <% end %>

    <!-- 削除 -->
    <a id="modal-delete"
      href="#"
      data-turbo-method="delete"
      data-turbo-confirm="削除しますか？">
      <%= image_tag "削除.png", class: "delete-icon" %>
    </a>

    <!-- 閉じる -->
    <div id="modal-close" class="modal-close"></div>
  </div>
</div>