<% content_for :header_title do %>
  <div class="header-title-with-icon">
     <%= image_tag "スパイダーマン.png", class: "header-icon" %>
     ホーム
  </div>
<% end %>

<div class="status-bar">
  <div class="status-item">

    <!-- 今週 -->
    <div class="status-block">
      <span class="status-label">今週</span>
      <div class="reward-button">
        スタンプ <%= @this_week_stamps %> 個
      </div>
    </div>

    <div class="status-divider"></div>

    <!-- 保有 -->
    <div class="status-block">
      <span class="status-label">保有</span>

      <div class="status-stamp">
        <%= image_tag "ガントレット.png", class: "status-icon" %>
        <span class="multiplication"> ×</span>
        <%= current_user.stamp_amount / 15 %> 個
      </div>

    </div>

  </div>
</div>

<!-- ===== 今日の予定 ===== -->
<div class="chore-list">

  <span class="today-chore-schedule">
    <%= image_tag "チェックリスト.png", class: "checklist-icon" %>
    <span>今日の予定</span>
  </span>

  <% if @today_chore_dates.any? %>

    <!-- ヘッダー -->
    <div class="chore-row-header chore-header">
      <div class="chore-title-header-homes">家事名</div>
      <div class="chore-reward-header-homes">報酬</div>
      <div class="chore-date-header-homes">時間</div>
    </div>

    <% @today_chore_dates.each do |chore_date| %>
      <% chore = chore_date.chore %>

      <div class="chore-row js-open-modal"
        data-chore-id="<%= chore.id %>"
        data-chore-date-id="<%= chore_date.id %>"
        data-chore-title="<%= chore.title %>">

        <!-- 左：カテゴリ＋タイトル -->
        <div class="chore-main">

          <!-- 丸アイコン -->
          <div class="chore-icon">
            <%= image_tag chore.category.stamp, class: "category-icon-home" %>
          </div>

          <!-- テキスト -->
          <div class="chore-text">
            <span class="category-badge"
                  style="background-color: <%= chore.category.color %>;">
              <%= chore.category.name %>
            </span>

            <div class="chore-title">
              <%= chore.title %>
            </div>
          </div>

        </div>

        <!-- 中央：報酬 -->
        <div class="chore-reward-area">
          <div class="reward-button">
            スタンプ <%= chore.stamp_reward %> 個
          </div>
        </div>

        <!-- 右：時間 -->
        <div class="chore-time-area">
          <%= chore_date.execute_at.strftime("%H:%M") %>
        </div>

      </div>

    <% end %>

  <% else %>

    <div class="empty-chore-card">
      <p class="empty-message">今日のやる家事はありません</p>
      <%= link_to "予定を追加", new_chore_path, class: "empty-add-btn" %>
    </div>

  <% end %>

</div>


<!-- ===== 昨日のやり残し ===== -->
<div class="chore-list">

  <span class="yesterday-chore-schedule">
    <%= image_tag "チェックリスト.png", class: "checklist-icon" %>
    <span>昨日やり残した家事</span>
  </span>

  <% if @yesterday_chore_dates.any? %>

    <!-- ヘッダー -->
    <div class="chore-row-header chore-header">
      <div class="chore-title-header-homes">家事名</div>
      <div class="chore-reward-header-homes">報酬</div>
      <div class="chore-date-header-homes">時間</div>
    </div>

    <% @yesterday_chore_dates.each do |chore_date| %>
      <% chore = chore_date.chore %>

      <div class="chore-row js-open-modal"
        data-chore-id="<%= chore.id %>"
        data-chore-date-id="<%= chore_date.id %>"
        data-chore-title="<%= chore.title %>">

        <!-- 左：カテゴリ＋タイトル -->
        <div class="chore-main">

          <!-- 丸アイコン -->
          <div class="chore-icon">
            <%= image_tag chore.category.stamp, class: "category-icon-home" %>
          </div>

          <!-- テキスト -->
          <div class="chore-text">
            <span class="category-badge"
                  style="background-color: <%= chore.category.color %>;">
              <%= chore.category.name %>
            </span>

            <div class="chore-title">
              <%= chore.title %>
            </div>
          </div>

        </div>

        <!-- 中央：報酬 -->
        <div class="chore-reward-area">
          <div class="reward-button">
            スタンプ <%= chore.stamp_reward %> 個
          </div>
        </div>

        <!-- 右：時間 -->
        <div class="chore-time-area">
          <%= chore_date.execute_at.strftime("%H:%M") %>
        </div>

      </div>

    <% end %>

  <% else %>

    <p class="no-chore-message">昨日やり残した家事はありません</p>
  <% end %>

</div>


<!-- ===== 下部リンク ===== -->
<div class="home-links-box">
  <%= link_to homes_previous_path, class: "home-link-item" do %>
    <span class="link-text">過去のやり残しを見る</span>
  <% end %>

  <%= link_to chores_path, class: "home-link-item" do %>
    <span class="link-text">すべての家事を見る</span>
  <% end %>
</div>

<%= link_to "＋", new_chore_path, class: "chore-create-btn" %>

<%= render "popup" %>