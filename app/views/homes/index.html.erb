<% content_for :header_title do %>
  🏠 ホーム
<% end %>

<% content_for :header_right do %>
  <%= link_to profile_index_path, class: "header-item" do %>
    <span class="header-profile">
      <span class="header-icon">
        <%= image_tag(
          current_user.avatar_image.attached? ?
            current_user.avatar_image :
            "default_avatar.png",
          class: "user-avatar"
        ) %>
      </span>
    </span>
  <% end %>
<% end %>

<h3>今日の予定</h3>

<% if @today_chore_dates.any? %>
  <div class="chore-list-home">
    <% @today_chore_dates.each do |chore_date| %>
      <% chore = chore_date.chore %>

      <div class="chore-row js-open-modal"
        data-chore-date-id="<%= chore_date.id %>"
        data-chore-title="<%= chore.title %>"
        data-chore-detail="<%= chore.detail %>">

        <div class="chore-title-detail">
          <span class="chore-title"><%= truncate(chore.title, length: 7) %></span>
          <span class="chore-detail">
            <%= truncate(chore.detail, length: 13) %>
          </span>
        </div>

        <div class="chore-cake-reward">
          <% reward = chore.cake_reward.to_i %>

          <% if reward <= 5 %>
            <% reward.times do %>
              <%= image_tag "shortcake.png", class: "cake-icon" %>
            <% end %>
          <% else %>
            <%= image_tag "shortcake.png", class: "cake-icon" %>
            <span class="cake-multiple">×<%= reward %></span>
          <% end %>
        </div>

        <div class="chore-actions-home">
          <span class="chore-time">
            <%= chore_date.execute_at.strftime("%H:%M") %>
          </span>
        </div>

      </div>
    <% end %>
  </div>
<% else %>
  <p>今日やる家事はありません</p>
<% end %>

<h3>昨日やり残した家事</h3>

<% if @yesterday_chore_dates.any? %>
  <div class="chore-list-home">
    <% @yesterday_chore_dates.each do |chore_date| %>
      <% chore = chore_date.chore %>

      <div class="chore-row">

        <div class="chore-title-detail">
          <span class="chore-title"><%= truncate(chore.title, length: 7) %></span>
          <span class="chore-detail">
            <%= truncate(chore.detail, length: 13) %>
          </span>
        </div>

      <div class="chore-cake-reward">
        <% reward = chore.cake_reward.to_i %>

        <% if reward <= 5 %>
          <% reward.times do %>
            <%= image_tag "shortcake.png", class: "cake-icon" %>
          <% end %>
        <% else %>
          <%= image_tag "shortcake.png", class: "cake-icon" %>
          <span class="cake-multiple">×<%= reward %></span>
        <% end %>
      </div>

        <div class="chore-actions-home">
          <span class="chore-time">
            <%= chore_date.execute_at.strftime("%H:%M") %>
          </span>
        </div>

      </div>
    <% end %>
  </div>
<% else %>
  <p>昨日やり残した家事はありません</p>
<% end %><br>

<%= link_to "過去のやり残し", homes_previous_path %>

<% content_for :fixed_ui_right do %>
  <%= link_to "家事作成", new_chore_path, class: "fixed-btn" %>
<% end %>

<%= render "popup" %>