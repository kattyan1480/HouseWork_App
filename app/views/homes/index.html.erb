<% content_for :header_title do %>
  🏠 ホーム
<% end %>

<% content_for :header_right do %>
  <%= link_to profile_index_path, class: "header-item" do %>
    <span class="header-profile">
      <span class="header-icon">
        <%= image_tag current_user.avatar_image_or_default, class: "user-avatar-history" %>
      </span>
    </span>
  <% end %>
<% end %>

<h3>今日の予定</h3>

<% if @today_chore_dates.any? %>
  <div class="chore-list-home">

    <div class="chore-row-header chore-header">
      <div class="chore-title-header-homes">家事名</div>
      <div class="chore-reward-header-homes">報酬</div>
      <div class="chore-date-header-homes">日時</div>
    </div>

    <% @today_chore_dates.each do |chore_date| %>
      <% chore = chore_date.chore %>

      <div class="chore-row-home js-open-modal"
        data-chore-id="<%= chore.id %>"
        data-chore-date-id="<%= chore_date.id %>"
        data-chore-title="<%= chore.title %>">

        <div class="chore-title"><%= truncate(chore.title, length: 15) %></div>

        <div class="chore-cake-reward">
          <% reward = chore.cake_reward.to_i %>

          <% if reward <= 5 %>
            <% reward.times do %>
              <%= image_tag "shortcake.png", class: "cake-icon" %>
            <% end %>
          <% else %>
            <%= image_tag "shortcake.png", class: "cake-icon" %>
            <span class="cake-multiple">×<%= reward %></span>
          <% end %>
        </div>

        <div class="chore-actions-home">
          <span class="chore-time">
            <%= chore_date.execute_at.strftime("%H:%M") %>
          </span>
        </div>

      </div>
    <% end %>
  </div>
<% else %>
  <p>今日やる家事はありません</p>
<% end %>

<h3>昨日やり残した家事</h3>

<% if @yesterday_chore_dates.any? %>
  <div class="chore-list-home">

    <div class="chore-row-header chore-header">
      <div class="chore-title-header-homes">家事名</div>
      <div class="chore-reward-header-homes">報酬</div>
      <div class="chore-date-header-homes">日時</div>
    </div>

    <% @yesterday_chore_dates.each do |chore_date| %>
      <% chore = chore_date.chore %>

      <div class="chore-row-home js-open-modal"
        data-chore-id="<%= chore.id %>"
        data-chore-date-id="<%= chore_date.id %>"
        data-chore-title="<%= chore.title %>">

        <div class="chore-title"><%= truncate(chore.title, length: 15) %></div>

        <div class="chore-cake-reward">
          <% reward = chore.cake_reward.to_i %>

          <% if reward <= 5 %>
            <% reward.times do %>
              <%= image_tag "shortcake.png", class: "cake-icon" %>
            <% end %>
          <% else %>
            <%= image_tag "shortcake.png", class: "cake-icon" %>
            <span class="cake-multiple">×<%= reward %></span>
          <% end %>
        </div>

        <div class="chore-actions-home">
          <span class="chore-time">
            <%= chore_date.execute_at.strftime("%H:%M") %>
          </span>
        </div>

      </div>
    <% end %>
  </div>
<% else %>
  <p>昨日やり残した家事はありません</p>
<% end %><br>

<div class="home-links-box">
  <%= link_to homes_previous_path, class: "home-link-item" do %>
    <span class="link-text">過去のやり残しを見る</span>
    <span class="link-arrow">></span>
  <% end %>

  <%= link_to chores_path, class: "home-link-item" do %>
    <span class="link-text">すべての家事を見る</span>
    <span class="link-arrow">></span>
  <% end %>
</div>

<%= link_to "＋", new_chore_path, class: "chore-create-btn" %>

<%= render "popup" %>