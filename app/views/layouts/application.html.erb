<head>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="layout">
    <%= render "layouts/header" %>

    <div id="flash-messages" data-controller="flash">
      <% flash.each do |type, message| %>
        <div class="flash-message flash-<%= type %> js-flash">
          <%= message %>
        </div>
      <% end %>
    </div>

    <main class="<%= content_for?(:main_class) ? yield(:main_class) : 'content' %>">
      <div class="content-inner">
        <%= yield %>
      </div>
    </main>

    <% if content_for?(:fixed_ui_right) %>
      <div class="fixed-bottom-right">
        <%= yield :fixed_ui_right %>
      </div>
    <% end %>

    <% if content_for?(:fixed_ui_left) %>
      <div class="fixed-bottom-left">
        <%= yield :fixed_ui_left %>
      </div>
    <% end %>

    <%= render "layouts/footer" if show_footer? %>
  </div>
</body>
