<head>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <div class="layout">
    <%= render "layouts/header" %>

    <% if notice %>
      <div class="notice"><%= notice %></div>
    <% end %>

    <% if alert %>
      <div class="alert"><%= alert %></div>
    <% end %>

    <main class="content">
      <div class="content-inner">
        <%= yield %>
      </div>
    </main>

    <% if content_for?(:fixed_ui_right) %>
      <div class="fixed-bottom-right">
        <%= yield :fixed_ui_right %>
      </div>
    <% end %>

    <% if content_for?(:fixed_ui_left) %>
      <div class="fixed-bottom-left">
        <%= yield :fixed_ui_left %>
      </div>
    <% end %>

    <%= render "layouts/footer" if show_footer? %>
  </div>
</body>
