<header class="app-header">
  <div class="header-left">
    <%= image_tag "logo.png", alt: "家事アプリ", class: "logo-image" %>
  </div>

  <div class="header-center">
    <strong>
      <%= content_for?(:header_title) ? yield(:header_title) : "" %>
    </strong>
  </div>

  <div class="header-right">
    <%= content_for?(:header_right) ? yield(:header_right) : "" %>
  </div>
</header>
