<% content_for :header_title do %>
    家事詳細
<% end %>

<div class="form-wrapper-chore">
  <div class="form-card">

    <div class="form-group">
      <label class="form-label">家事名</label>
      <div class="form-input display-field">
        <%= @chore_date.chore.title %>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">貰えるショートケーキの数</label>
      <div class="form-input display-field">
        <%= @chore_date.chore.cake_reward %>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">実行日</label>
      <div class="form-input display-field">
        <%= @chore_date.execute_at.strftime("%Y/%-m/%-d") %>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">実行時間</label>
      <div class="form-input display-field">
        <%= @chore_date.execute_at.strftime("%H:%M") %>
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">備考</label>
      <div class="form-textarea display-field">
        <%= @chore_date.chore.detail.presence || "未入力" %>
      </div>
    </div>

    <div class="form-actions">
      <%= link_to "キャンセル", homes_index_path, class: "back-link" %>
    </div>

  </div>
</div>
