<% content_for :header_title do %>
  <span class="header-profile">
    <span class="header-icon">
      <%= image_tag(
        current_user.avatar_image.attached? ?
        current_user.avatar_image :
        "default_avatar.png",
        class: "user-avatar"
      ) %>
    </span>
   <span class="header-text">プロフィール</span>
  </span>
<% end %>

<% content_for :fixed_ui_left do %>
  <%= link_to "戻る", homes_index_path, class: "fixed-link" %>
<% end %>

<%= link_to "ログアウト",
            destroy_user_session_path,
            data: { turbo_method: :delete } %>