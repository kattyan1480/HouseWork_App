<% content_for :header_title do %>
  カテゴリ
<% end %><br>

<div class="category-wrapper">

  <% if @categories.any? %>
    <div class="category-grid">
      <% @categories.each do |category| %>

        <div class="category-card">

          <%= link_to image_tag("削除.png", class: "delete-icon"),
                      category_path(category),
                      data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                      class: "delete-link" %>

          <%= link_to category_path(category), class: "card-main-link" do %>

            <div class="category-icon">
              <%= image_tag category.stamp %>
            </div>

            <span class="category-name"
                  style="background-color: <%= category.color %>;">
              <%= category.name %>
            </span>

          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="category-empty">
      カテゴリーがまだありません
    </div>
  <% end %>

  <div class="category-header">
    <%= link_to "＋カテゴリを追加", new_category_path, class: "category-add-btn" %>
  </div>

</div>

<% content_for :fixed_ui_left do %>
  <%= link_to "戻る", homes_index_path, class: "fixed-link" %>
<% end %>