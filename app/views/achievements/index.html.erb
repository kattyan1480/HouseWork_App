<% content_for :header_title do %>
  💪 成果
<% end %>

<div class="member-tabs">
  <% @users.each do |user| %>
    <%= link_to achievements_path(user_id: user.id),
                class: "member-tab #{'active' if user == @user}" do %>
      <%= image_tag user.avatar_image_or_default, class: "user-avatar-achievement" %>
    <% end %>
  <% end %>
</div>

<h3>今の保有ケーキ</h3>

<div class="achievement-panel">

  <div class="top-decor">✦</div>

  <div class="cake-display">

    <% remainder = @user.cake_amount % 8 %>
    <% completed = @user.cake_amount / 8 %>
    <% remaining = remainder.zero? ? 0 : 8 - remainder %>

    <div class="cake-wrapper">
      <%= image_tag "holecake#{remainder.zero? ? 8 : remainder}.png",
            class: "cake-icon whole" %>

      <!-- 右上：完成まで -->
      <div class="cake-info top-right">
        完成まで <span class="number"><%= remaining %>ピース</span>
      </div>

      <!-- 右下：完成ホール数 -->
      <div class="cake-count-plain">
        <div class="cake-count-label">
          完成したホールケーキ
        </div>

        <div class="cake-count-body">
          <%= image_tag "holecake8.png", class: "mini-cake" %>
          <span class="count">× <%= completed %> 個</span>
        </div>
      </div>

    </div> <!-- cake-wrapper -->

  </div> <!-- ★ cake-display を閉じる -->

  <div class="bottom-decor">✦</div>

</div>

<%= render "rewards/index" %>