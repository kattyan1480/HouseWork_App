<% @user.rewards.each do |reward| %>

<div class="modal hidden js-reward-popup"
     data-reward-id="<%= reward.id %>">

  <div class="modal-overlay"></div>

  <div class="modal-content">

    <div class="modal-title-area">
      <div class="modal-reward-title">
        <%= reward.title %>
      </div>

      <% if user == current_user %>
        <%= link_to edit_reward_path(reward) do %>
          <%= image_tag "編集.png", class: "edit-icon-reward" %>
        <% end %>
      <% end %>
    </div>

    <div class="reward-cost">
      <div class="reward-cost-label">
        獲得後に残るガントレット
      </div>

      <div class="reward-cost-value">
        <%= image_tag "ガントレット.png", class: "reward-stamp-icon" %>
        <div class="multiplication">×</div><%= reward.remain_special_after(current_user) %>
      </div>
    </div>

    <% if user == current_user %>
      <div class="modal-buttons-gain">
        <%= button_to "獲得する",
            expend_reward_path(reward),
            method: :post %>
      </div>
    <% end %>

    <div class="modal-close js-close-modal"></div>

  </div>

</div>

<% end %>