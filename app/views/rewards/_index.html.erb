<div class="reward-container">

  <% @rewards.each_with_index do |reward, i| %>

    <div class="reward-box reward-bg-<%= i %> js-open-reward-popup"
         data-reward-id="<%= reward.id %>">

      <div class="reward-left">

        <div class="reward-title">
          🎁<%= reward.title %>
        </div>

        <div class="reward-need">
          必要なガントレット<br>

          <span class="stamp-count">
            <%= image_tag "ガントレット.png", class: "mini-stamp-reward" %>
            ×<%= reward.special_cost %>
          </span>

        </div>

      </div>

      <div class="reward-right">

        <div class="reward-circle <%= reward.achieved?(current_user) ? "ok" : "ng" %>">

          <% if reward.achieved?(current_user) %>

            達成!

          <% else %>

            <span class="reward-label">達成まで</span>
            <strong><%= reward.until_special(current_user) %>個</strong>

          <% end %>

        </div>

      </div>

    </div>

  <% end %>

  <%= render "rewards/popup", user: current_user %>

</div>