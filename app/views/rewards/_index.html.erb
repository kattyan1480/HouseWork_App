<h3>ごほうび</h3>

<div class="reward-container">
  <div class="reward-box js-open-reward-popup">
    <% if @user.reward.present? %>
        <%= @user.reward.title %>
        <p>進捗：
          <% 
            cake_cost   = @user.reward.cake_cost.to_i
            cake_amount = @user.cake_amount.to_i

            full_count = cake_amount / 8
            half_exist = (cake_amount % 8) >= 4
          %>

          <% cake_cost.times do |i| %>
            <% if i < full_count %>
              <%= image_tag "holecake.png", class: "reward-cake-icon whole" %>

            <% elsif i == full_count && half_exist %>
              <%= image_tag "holecake-half.png", class: "reward-cake-icon whole" %>

            <% else %>
              <%= image_tag "holecake-blank.png", class: "reward-cake-icon whole" %>
            <% end %>
          <% end %>
        </p>

        <% if @user.cake_amount >= @user.reward.cake_cost %>
          <p class="reward-ok">🎉 達成可能！</p>

        <% else %>
          <p class="reward-ng">
            あと <%= @user.reward.cake_cost - @user.cake_amount %> ケーキ
          </p>
        <% end %>
    <% else %>
      <% if @user == current_user %>
        <%= link_to "ご褒美を設定する", new_reward_path, class: "btn btn-primary" %>
      <% else %>
        <p>ご褒美未設定</p>
      <% end %>
    <% end %>
  </div>
  <%= render "rewards/popup", user: @user %>
</div>