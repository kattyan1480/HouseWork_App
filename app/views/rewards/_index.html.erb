<div class="reward-container">
  <div class="reward-box js-open-reward-popup">
    <% if @user.reward.present? %>
      <% 
        cake_cost   = @user.reward.cake_cost.to_i
        cake_amount = @user.cake_amount.to_i
        remain      = cake_cost - cake_amount / 8
      %>
      
      <div class="reward-left">
        <!-- 左上：ご褒美タイトル -->
        <div class="reward-title">
          🎁<%= @user.reward.title %>
        </div>

        <!-- 左下：必要なホールケーキ数 -->
        <div class="reward-need">
          必要なホールケーキ<br>
          <span class="cake-count">
            <%= image_tag "holecake8.png", class: "mini-cake-reward" %>
            ×<%= cake_cost %>個
          </span>
        </div>
      </div>

      <!-- 右：残り数を丸で表示 -->
      <div class="reward-right">
        <div class="reward-circle <%= remain <= 0 ? "ok" : "ng" %>">
          <% if remain <= 0 %>
             達成!
          <% else %>
            <span class="reward-label">達成まで</span>
            <strong><%= remain %>ホール</strong>
          <% end %>
        </div>
      </div>

    <% else %>
      <% if @user == current_user %>
        <%= link_to "ご褒美を設定する", new_reward_path, class: "btn btn-primary" %>
      <% else %>
        <p>ご褒美未設定</p>
      <% end %>
    <% end %>
  </div>
  <%= render "rewards/popup", user: @user %>
</div>