<% content_for :header_title do %>
  ログイン
<% end %>

<div class="content">
  <div class="form-wrapper-chore">
    <div class="form-card">

      <%= form_for(resource,
            as: resource_name,
            url: session_path(resource_name),
            html: { data: { turbo: false } }) do |f| %>

        <!-- メール -->
        <div class="form-group">
          <%= f.label :email, "メールアドレス", class: "form-label" %>

          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                placeholder: "example@example.com",
                class: "form-input #{'input-error' if resource.errors[:email].any?}" %>

          <% if resource.errors[:email].any? %>
            <div class="field-error-message">
              <%= resource.errors.full_messages_for(:email).first %>
            </div>
          <% end %>
        </div>

        <!-- パスワード -->
        <div class="form-group">
          <%= f.label :password, "パスワード", class: "form-label" %>

          <%= f.password_field :password,
                autocomplete: "current-password",
                placeholder: "パスワードを入力してください",
                class: "form-input #{'input-error' if resource.errors[:password].any?}" %>

          <% if resource.errors[:password].any? %>
            <div class="field-error-message">
              <%= resource.errors.full_messages_for(:password).first %>
            </div>
          <% end %>
        </div>

      <% if resource.errors[:base].any? %>
        <div class="field-error-message">
          <%= resource.errors[:base].first %>
        </div>
      <% end %>

        <!-- Remember -->
        <% if devise_mapping.rememberable? %>
          <div class="form-group remember-me">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me, "ログイン状態を保持" %>
          </div>
        <% end %>

        <div class="form-actions">
          <%= f.submit "ログイン", class: "submit-btn" %>
        </div>

      <% end %>

      <div class="devise-links">
        <%= render "devise/shared/links" %>
      </div>

    </div>
  </div>
</div>