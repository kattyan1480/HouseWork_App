<% content_for :header_title do %>
  ユーザー登録
<% end %>

<div class="content">
  <div class="form-wrapper-chore">
    <div class="form-card">

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

        <!-- メールアドレス -->
        <div class="form-group">
          <div class="label-row">
            <%= f.label :email, "メールアドレス", class: "form-label" %>
          </div>

          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                placeholder: "example@example.com",
                class: "form-input #{'input-error' if resource.errors[:email].any?}" %>

          <% if resource.errors[:email].any? %>
            <div class="field-error-message">
              <%= resource.errors.full_messages_for(:email).first %>
            </div>
          <% end %>
        </div>

        <!-- パスワード -->
        <div class="form-group">
          <div class="label-row">
            <%= f.label :password, class: "form-label" do %>
              パスワード
              <% if @minimum_password_length %>
                （<%= @minimum_password_length %>文字以上）
              <% end %>
            <% end %>
          </div>

          <%= f.password_field :password,
                autocomplete: "new-password",
                placeholder: "パスワードを入力してください",
                class: "form-input #{'input-error' if resource.errors[:password].any?}" %>

          <% if resource.errors[:password].any? %>
            <div class="field-error-message">
              <%= resource.errors.full_messages_for(:password).first %>
            </div>
          <% end %>
        </div>

        <!-- パスワード確認 -->
        <div class="form-group">
          <div class="label-row">
            <%= f.label :password_confirmation, "パスワード確認", class: "form-label" %>
          </div>

          <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                placeholder: "パスワードを再入力してください",
                class: "form-input #{'input-error' if resource.errors[:password_confirmation].any?}" %>

          <% if resource.errors[:password_confirmation].any? %>
            <div class="field-error-message">
              <%= resource.errors.full_messages_for(:password_confirmation).first %>
            </div>
          <% end %>
        </div>

        <!-- ボタン -->
        <div class="form-actions">
          <%= f.submit "登録", class: "submit-btn" %>
        </div>

      <% end %>

      <div class="devise-links">
        <%= render "devise/shared/links" %>
      </div>

    </div>
  </div>
</div>