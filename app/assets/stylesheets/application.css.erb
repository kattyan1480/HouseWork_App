
@import "https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css";

html, body {
  height: 100%;
  margin: 0;
}

body {
  flex-direction: column;
  overflow: hidden;
  font-family: 'Noto Sans JP', sans-serif;
  font-weight: 400;
  letter-spacing: 0.02em;
  -webkit-font-smoothing: antialiased;
  position: relative;
}

/* 背景画像 */
body::before {
  content: "";
  position: fixed;
  inset: 0;

  background-image: url("<%= asset_path 'marvel.jpg' %>");
  background-size: cover;
  background-position: center;

  opacity: 0.03; /* ← 薄さ（調整ポイント） */

  z-index: -1;
}

/* ===== ヘッダー ===== */
.app-header {
  background: linear-gradient(
    to bottom,
    #b71a31 0%,
    #9f1022 55%,
    #870d1c 100%
  );

  height: 80px;
  padding: 0 20px;

  display: flex;
  justify-content: space-between;
  align-items: center;

  border-bottom: 1px solid rgba(0,0,0,0.2);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.18),
    0 3px 6px rgba(0,0,0,0.18);

  flex-shrink: 0;
}

/* ===== フッター ===== */
.app-footer {
  background: linear-gradient(
    to bottom,
    #24304a 0%,
    #1b2a49 70%,
    #141f38 100%
  );

  height: 110px;
  padding: 0 40px;

  display: flex;
  justify-content: space-between;
  align-items: center;

  border-top: 1px solid rgba(255,255,255,0.05);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.04),
    0 -2px 5px rgba(0,0,0,0.18);

  flex-shrink: 0;
}

.footer-item {
  color: #CCCCCC;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24px;
}

.footer-icon {
  width: 60px;
  height: auto;
  padding-top: 2px;
}

.footer-icon-achievement {
  width: 13px;
  height: auto;
}

.header-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #ffffffda;
  font-size: 28px;
}

.avatar-upload {
  display: flex;
  flex-direction: column; /* 縦並び */
  gap: 6px; /* ボタンと文字の間の余白 */
}

.layout {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 画面全体の中央寄せ用 */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;   /* 横中央 */
  padding-top: 20px;
  align-items: center;
  width: 100%;
  overflow-y: auto;        /* 縦スクロール */
}

/* 画面全体の中央寄せ用 */
.content-achievement {
  flex: 1;
  display: flex;
  flex-direction: column;   /* 横中央 */
  align-items: center;
  width: 100%;
  overflow-y: auto;        /* 縦スクロール */
}

.content-inner {
  width: 100%;
  max-width: 980px;
  margin: 0 auto;
  padding-bottom: 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 全体幅 */
.chore-list {
  width: 90%;
  display: flex;
  flex-direction: column;
}

/* 全体幅 */
.chore-list-history {
  width: 90%;
  display: flex;
  flex-direction: column;
}

/* =======================
   ヘッダー
======================= */
.chore-row-header {
  display: flex;
  height: 50px;
  border: 1px solid #444444;   /* 外枠 */
  border-bottom: none;
}

.chore-row-header > div {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #444444;
  color: white;
  font-size: 26px;
  font-weight: 600;
  /* 区切り線 */
  border-right: 2px solid #ffffff;
}

/* 一番右だけ線を消す */
.chore-row-header > div:last-child {
  border-right: none;
}

.chore-title-header-homes { flex: 1; }
.chore-reward-header-homes   { width: 220px; }
.chore-date-header-homes     { width: 140px; }

.chore-title-header-chores-index { flex: 1; }
.chore-reward-header-chores-index   { width: 220px; }
.chore-action-header-chores-index     { width: 140px; }

.chore-title-header-chores-history { flex: 1; }
.chore-reward-header-chores-history   { width: 220px; }
.chore-date-header-chores-history     { width: 140px; }
.chore-user-header-chores-history     { width: 140px; }

/* =======================
   行デザイン
======================= */
.chore-row {
  display: flex;
  align-items: center;
  padding: 4px 0px;
  border: 1px solid #dddddd;
  border-top: none;
  cursor: pointer;
}

.chore-row:nth-of-type(odd) {
  background-color: #f0f1f5;
}

.chore-row:nth-of-type(even) {
  background-color: #ffffff;
}

/* 左側 */
.chore-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16px;
  margin-left: 16px;
}

.chore-icon {
  width: 60px;
  height: 60px;
  border-radius: 50%;

  background-color: inherit;
  border: 1px solid rgba(0,0,0,0.05); /* うっすら縁 */

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;
}

.category-icon-home {
  width: 60px;              /* ← 少し小さく */
  height: 60px;
  object-fit: contain;      /* 画像比率を崩さない */

  margin: 0;                /* ← これが重要 */
}

/* テキストエリア */
.chore-text {
  display: flex;
  flex-direction: column;
}

/* カテゴリバッジ */
.category-badge {
  display: inline-block;
  padding: 1px 6px;
  border-radius: 6px;
  font-size: 20px;
  color: #313131;
  font-weight: 600;
  width: fit-content;
}

/* 家事タイトル */
.chore-title {
  font-size: 30px;
  font-weight: 700;
  color: #383838;
}

/* =======================
   報酬
======================= */
.chore-reward-area {
  width: 220px;
  display: flex;
  align-items: center;
  justify-content: center;   /* ← 中央 */
}

.reward-button {
  background-color: #ffffff;
  border: 2px solid #444444;
  color: #383838;
  padding: 5px 10px;
  border-radius: 5px;
  font-size: 26px;
  font-weight: 600;
}

/* =======================
   時間
======================= */
.chore-time-area {
  width: 140px;
  text-align: center;

  font-size: 26px;
  font-weight: 700;
  letter-spacing: 1px;

  border-radius: 8px;
  color: #383838;
}

/* =======================
    アクション
======================= */
.chore-action-area {
  width: 140px;
  text-align: center;

  letter-spacing: 1px;

  border-radius: 8px;
  color: #383838;
}

/* =======================
    ユーザー
======================= */
.chore-user-area {
  width: 140px;
  text-align: center;

  border-radius: 8px;
  color: #383838;
}

/* 空状態カード */
.empty-chore-card {
  background: #ffffff;
  border-radius: 4px;
  padding: 20px;
  margin-top: 4px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}

/* メッセージ */
.empty-message {
  font-size: 30px;
  color: #464646;
  margin-bottom: 16px;
  margin-top: 0px;
}

.empty-add-btn {
  display: block;
  background: #f3b769;
  color: #333;
  text-decoration: none;
  padding: 8px 0;
  border-radius: 6px;
  font-weight: 500;
  font-size: 30px;
}

.edit-link {
  text-decoration: none;
}

.delete-link {
  text-decoration: none;
  position: absolute;
  top: 8px;
  left: 8px;
  z-index: 10;
}

/* フォーム＋エラーをまとめる箱 */
.form-wrapper {
  max-width: 420px;
  max-width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ボタン */
.actions {
  display: flex;
  justify-content: center;
  margin-top: 20px;
}

/* フィールド */
.field {
  display: flex;
  flex-direction: column;
  padding-bottom: 16px;
}

.field input:not([type="checkbox"]) {
  width: 100%;
  box-sizing: border-box;
}

.field.remember-me {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
}

.content.selectorjoin {
  display: flex;
  flex-direction: column; /* 縦並び */
  align-items: center;
  justify-content: flex-start;
  padding-top: 40px;
  gap: 16px;
}

.header-logo {
  display: flex;
  align-items: center;
}

.logo-image {
  height: 50px;
  width: auto;
  margin: 0px 0;   /* ← 上下余白 */
}

.hidden-calendar-input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
  height: 0;
  width: 0;
}

.stamp-icon {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  aspect-ratio: 1 / 1;

  background: #fff;
  border: 1px solid #595a7e;   /* 少し太めに */

  box-shadow: 
    2px 2px 0 rgba(0, 0, 0, 0.1);  /* 押した感じの影 */

  display: flex;
  align-items: center;
  justify-content: center;

  transition: all 0.1s ease;
}

/* 標準の file input を非表示 */
.hidden-file {
  display: none;
}

/* ファイル選択ボタン */
#avatar_button {
  cursor: pointer;
  padding: 4px 10px;      /* ボタンの大きさ */
  font-size: 12px;          /* ボタン文字の大きさ */
  background-color: #ebe8e8; /* お好みの背景色 */
  border: 1px solid #555;
  border-radius: 6px;
  text-align: center;
}

/* ファイル名表示 */
#avatar_filename {
  font-size: 12px;          /* 文字の大きさ */
  color: #555;              /* 文字色 */
  min-height: 1em;          /* 選択されていないときも高さを確保 */
}

.user-avatar {
  width: 37px;
  height: 37px;
  border-radius: 50%; /* 丸くする */
  object-fit: cover;  /* はみ出さない */
  align-items: center; /* 縦中央揃え */
}

/* アイコンを横並びにする親要素 */
.chore-users-history {
  width: 89px;
  display: flex;
  justify-content: flex-end;   /* ← 右詰め */
  gap: 4px;                    /* アイコン間の隙間 */
  align-items: center;         /* 縦中央揃え */
  box-sizing: border-box;      /* ← paddingを幅に含める */
}

/* アイコン自体 */
.user-avatar-history {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  object-fit: cover;
  line-height: 1;
  margin: 0;
  display: inline-block;
}

.avatar-preview {
  width: 80px;
  height: 80px;
  border-radius: 4px;
}

.header-profile {
  display: flex;
  align-items: center;
  gap: 6px;
}

.fixed-bottom-left {
  position: fixed;
  left: 40px;
  bottom: 130px;
  display: flex;
  gap: 12px;          /* ボタン間の隙間 */
  align-items: center;
  background-color: #e0e0e0;
}

.fixed-link {
  width: 130px;
  appearance: none;
  -webkit-appearance: none;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  height: 70px;
  padding: 10px 10px;

  border-radius: 5px;

  font-size: 30px;
  font-weight: 500;
  font-family: inherit;
  line-height: 1;

  border: 1px solid #535353;   /* ← 枠線を明示 */
  color: #000000;

  text-decoration: none;
  box-sizing: border-box;

  box-shadow: 0 16px 13px -12px rgba(0, 0, 0, -19.44), 0 4px 25px 0px rgba(0, 0, 0, 0.12), 0 8px 10px -5px rgba(0, 0, 0, 0.2);
}

.hidden {
  display: none;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
}

.modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

/* モーダル全体の箱 */
.modal-content {
  position: relative;
  background: #ffffff;
  border: 1px solid #535353;   /* ← 枠線を明示 */
  width: 500px;
  padding-top: 25px;
  padding-bottom: 15px;
  margin: 300px auto;      /* 画面中央に配置 */
  border-radius: 8px;

  display: flex;
  flex-direction: column; /* 中身を縦並び */
  align-items: center;    /* 中身を横方向中央寄せ */
  text-align: center;
  color: #000000;
  font-weight: normal;
}

/* タイトル＋詳細 横並び */
.modal-title-area {
  display: flex;
  align-items: center;   /* 縦中央揃え */
  justify-content: center; /* 横中央揃え */
}

/* タイトル */
.modal-chore-title {
  font-size: 30px;
  font-weight: 500;
  font-weight: bold;
  margin: 0;      /* 余計なズレ防止 */
  line-height: 1;
  display: flex;
}

#complete-form {
  margin: 0;
}

.member-select {
  position: relative;
  width: 300px;
  padding-top: 30px;
}

/* 上のボックス */
.member-select-header {
  height: 55px;
  background: #d1d1d165;
  border: 1px solid #2e2e2e;
  padding: 5px 7px;
  cursor: pointer;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26px;
}

/* 下の一覧 */
.member-select-dropdown {
  position: absolute;
  top: 100%;
  box-sizing: border-box;
  width: 100%;
  height: auto;
  background: #ffffff;
  border: 1px solid #a5a5a59a;
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  max-height: 180px;   /* ← 高さ固定 */
  overflow-y: auto;    /* ← スクロール */
  display: none;
  font-size: 26px;
}

.member-checkbox {
  display: block;
  padding: 8px 8px;
  border-bottom: 1px solid #c7c7c7;
  cursor: pointer;
}

/* チェックボックスサイズ */
.member-checkbox input[type="checkbox"]{
  transform: scale(1.5);
  margin-right: 8px;
}

.member-checkbox:last-child {
  border-bottom: none;
}

.member-checkbox:hover {
  background: #f5f5f5;
}

/* ボタン全体 */
.modal-buttons {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-top: 30px;
}

.modal-buttons-gain {
  display: flex;
  justify-content: center;
  width: 100%;
}

.modal-buttons-complete {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 1行目：完了ボタンを横いっぱいに */
.modal-buttons-gain button{
  width: 250px;
  height: 55px;
  padding: 3px 50px;
  border-radius: 8px;
  box-sizing: border-box; /* パディング込みで幅いっぱい */
  background-color: #57587e;
  color: #ffffff;
  margin-bottom: 4px;
  cursor: pointer;        /* 活性時はマウスカーソルを手に */
  transition: background 0.2s, color 0.2s; /* スムーズ切替 */
  font-size: 26px;
}

.modal-buttons-complete button {
  width: 100%;
  height: 55px;
  padding: 3px 50px;
  border-radius: 8px;
  box-sizing: border-box; /* パディング込みで幅いっぱい */
  background-color: #57587e;
  color: #ffffff;
  margin-bottom: 4px;
  cursor: pointer;        /* 活性時はマウスカーソルを手に */
  transition: background 0.2s, color 0.2s; /* スムーズ切替 */
  font-size: 26px;
}

/* ボタン全体 */
.modal-buttons-sub {
  display: flex;
  justify-content: center;
  width: 100%;
}

.modal-buttons-reschedule {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 300px;
  margin-top: 30px;
}

/* リスケボタン / 変更ボタンの共通スタイル */
.modal-buttons-reschedule button {
  width: 100%;
  height: 55px;
  margin: 0px;
  padding: 3px 50px;
  border-radius: 4px;
  box-sizing: border-box; /* パディング込みで幅いっぱい */
  border: 1px solid #000000;
  background: #e9e9e9f8;
  color: #000000;
  margin-bottom: 4px;
  cursor: pointer;        /* 活性時はマウスカーソルを手に */
  transition: background 0.2s, color 0.2s; /* スムーズ切替 */
  font-size: 26px;
}

/* ボタンが非活性（disabled）の時 */
.modal-buttons-reschedule button:disabled {
  background: #cccccc;    /* グレーっぽく */
  color: #666666;         /* 文字色も薄く */
  border: 1px solid #999999;
}

.hidden-calendar-input-reschedule {
  position: absolute;
  opacity: 0;
  pointer-events: none;
  height: 0;
  width: 0;
}

/* =========================
   削除アイコン（左上）
========================= */
#modal-delete {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 10;
}

/* ==============================
   reward専用
================================ */

/* タイトル（choreと同じ見た目） */
.modal-reward-title {
  font-size: 30px;
  font-weight: 500;
  font-weight: bold;
  margin: 0;
  padding-bottom: 8px;
}

/* コスト表示 */
.reward-cost {
  display: flex;
  flex-direction: column;  /* ← 縦並びにする */
  align-items: center;
  gap: 4px;
  font-size: 26px;
  padding-top: 8px;
}

.reward-cost-value {
  display: flex;
  align-items: center;
  gap: 4px;
  padding-bottom: 15px;
}

.reward-stamp-icon {
  width: 50px;
  height: 50px;
  display: block;
}

/* =========================
   タブ全体
========================= */
.member-tabs {
  display: flex;
  border-bottom: 1px solid #ddd;
  background: #ffffff;
  width: 970px;
  height: 70px;
}

/* =========================
   タブ
========================= */
.member-tab {
  width: 200px;
  text-decoration: none;
  padding: 10px 20px;
  position: relative;
  display: flex;
  justify-content: center;
}

/* 中身（アイコン＋名前） */
.member-tab-inner {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* 名前 */
.member-name {
  font-size: 28px;
  color: #111111;
  font-weight: 500;
}

/* アクティブタブ */
.member-tab.active::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 100%;
  height: 4px;
  background: #f3a13b;
}

/* アバター */
.user-avatar-achievement {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  object-fit: cover;
}

/* =========================
   ステータスエリア
========================= */
.status-bar{
  width:100%;
  display:flex;
  justify-content:center;
  margin-top:20px;
}

/* カード */
.status-item{
  width:84%;
  height:100px;
  display:flex;
  justify-content:space-around;
  align-items:center;

  padding:18px 30px;

  background:rgba(255,255,255,0.95);
  border-radius:8px;

  box-shadow:
    0 8px 20px rgba(0,0,0,0.12),
    0 2px 6px rgba(0,0,0,0.08);

  border:1px solid rgba(0,0,0,0.05);
}

/* 各ブロック */
.status-block{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
}

/* スタンプ表示部分 */
.status-stamp{
  display:flex;
  align-items:center;
  gap:6px;
  font-size:26px;
  font-weight:600;
}

/* 区切り線 */
.status-divider{
  width:1px;
  height:60px;
  background:#ddd;
}

/* アイコン */
.status-icon{
  width:55px;
  height:55px;
}

/* ラベル */
.status-label{
  font-size:24px;
  color:#666;
}

.multiplication{
  font-size:20px;
}

/* =========================
   スタンプ帳台紙
========================= */
.stamp-board{
  width:980px;
  height:780px;

  background-image:url("<%= asset_path 'stampsheet.jpg' %>");
  background-size:100% auto;
  background-repeat:no-repeat;
  background-position:top center;

  position:relative;

  display:grid;
  grid-template-columns:repeat(5,140px);
  justify-content:center;
  align-content:start;
  gap:25px;
  padding-top:100px;
}

/* 薄い白レイヤー */
.stamp-board::before{
  width:90%;
  height:61%;
  content:"";
  position:absolute;
  inset:0;
  margin-top:70px;

  left:50%;
  transform:translateX(-50%);  /* 横中央 */
  background:rgba(255,255,255,0.6);  /* 白の透明 */

  border-radius:12px;
  z-index:1;
}

/* スタンプ共通 */
.stamp{
  width:140px;
  height:140px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
  z-index:2;
}

/* 取得済み */
.stamp.active{
  background: #ffffff;
  border:1px solid #dadada;
  box-shadow:
  0 3px 6px rgba(0,0,0,0.2);
}

/* スタンプ画像 */
.stamp-img{
  width:80%;
}

