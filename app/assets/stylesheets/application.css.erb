 *= require flatpickr
 */
/*
 * This is a manifest file that'll be compiled into application.css, which will include all the files
 * listed below.
 *
 * Any CSS (and SCSS, if configured) file within this directory, lib/assets/stylesheets, or any plugin's
 * vendor/assets/stylesheets directory can be referenced here using a relative path.
 *
 * You're free to add application-wide styles to this file and they'll appear at the bottom of the
 * compiled file so the styles you add here take precedence over styles defined in any other CSS
 * files in this directory. Styles in this file should be added after the last require_* statement.
 * It is generally better to create a new file per style scope.
 *
 *= require_tree .
 *= require_self
/* flatpickr */
@import "https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css";

html, body {
  height: 100%;
  margin: 0;
}

body {
  flex-direction: column;
  background-color: #f2f7ffdc;
  overflow: hidden;
}

.app-header {
  background: #2E2F4E;
  height: 56px;
  padding: 0 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 16px 13px -12px rgba(0, 0, 0, 0), 0 4px 25px 0px rgba(0, 0, 0, 0.12), 0 8px 10px -5px rgba(0, 0, 0, 0.2);
  flex-shrink: 0
}

.app-footer {
  background: #2E2F4E;
  height: 48px;
  padding: 0 600px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 16px 13px -12px rgba(0, 0, 0, 0), 0 4px 25px 0px rgba(0, 0, 0, 0.12), 0 8px 10px -5px rgba(0, 0, 0, 0.2);
  flex-shrink: 0;
}

.footer-item {
  color: #ffffffbe;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 12px;
}

.footer-icon {
  width: 18px;
  height: auto;
  padding-top: 2px;
}

.footer-icon-achievement {
  width: 13px;
  height: auto;
}

.header-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #ffffffda;
}

.avatar-upload {
  display: flex;
  flex-direction: column; /* 縦並び */
  gap: 6px; /* ボタンと文字の間の余白 */
}

.layout {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 画面全体の中央寄せ用 */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;   /* 横中央 */
  padding-top: 20px;
  align-items: center;
  width: 100%;
  overflow-y: auto;        /* 縦スクロール */
}

.content-inner {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding-bottom: 50px;
  display: flex;
  flex-direction: column;
  align-items: center;   /* ← ここで使う */
}

.chore-list {
  display: flex;
  flex-direction: column;
  width: 45%;
}

.chore-list-history {
  display: flex;
  flex-direction: column;
  width: 50%;
}

.chore-list-home {
  display: flex;
  flex-direction: column;
  width: 42%;
}

.chore-list-previous {
  display: flex;
  flex-direction: column;
  width: 40%;
}

.chore-row {
  display: flex;
  align-items: center;
  height: 50px;
  padding: 0 16px;
  border: 1px solid #808080;
  border-top: none;
}

.chore-row-home {
  display: flex;
  align-items: center;
  height: 50px;
  padding: 0 16px;
  border: 1px solid #808080;
  border-top: none;
  cursor: pointer;
}

.chore-row-history {
  display: flex;
  align-items: center;
  height: 50px;
  padding: 0 16px;
  border: 1px solid #808080;
  border-top: none;
}

.chore-row-header {
  border-bottom: 1px solid #2e2e2e;
  display: flex;
  align-items: center;
  height: 38px;
  gap: 1px;
}

/* 各箱 */
.chore-row-header > div {
  border: 1px solid #2e2e2e;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #595a7e;
}

.chore-row-header .chore-title-header-chores-history { flex: 1; }
.chore-row-header .chore-reward-header-chores-history { width: 185px; }
.chore-row-header .chore-date-header-chores-history { width: 70px; }
.chore-row-header .chore-users-header-chores-history { width: 95px; }

.chore-row-header .chore-title-header-chores-index { flex: 1; }
.chore-row-header .chore-reward-header-chores-index { width: 195px; }
.chore-row-header .chore-edit-header-chores-index { width: 95px; }

.chore-row-header .chore-title-header-homes { flex: 1; }
.chore-row-header .chore-reward-header-homes { width: 185px; }
.chore-row-header .chore-date-header-homes { width: 70px; }

/* ヘッダー基本 */
.chore-header {
  color: rgb(253, 253, 253);
  font-size: 14px;
  font-weight: 500;
}

.chore-row-home:not(.chore-header):nth-child(odd),
.chore-row-history:not(.chore-header):nth-child(odd),
.chore-row:not(.chore-header):nth-child(odd) {
  background-color: #aca8a82f;
}

.chore-row-home:not(.chore-header):nth-child(even),
.chore-row-history:not(.chore-header):nth-child(even),
.chore-row:not(.chore-header):nth-child(even) {
  background-color: #ffffff;
}

.chore-title {
  display: flex;
  align-items: center;
  flex: 1;               /* ここが超重要 */
  min-width: 0;
  font-size: 15px;
  font-weight: 500;
  margin-right: 12px;
  white-space: nowrap;   /* 折り返さない */
}

.chore-cake-reward {
  width: 80px;
  text-align: right;
  font-size: 16px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.chore-actions-home {
  width: 60px;
  text-align: right;
}

.chore-actions-previous {
  width: 80px;
  text-align: right;
}

.chore-actions-history {
  width: 70px;
  text-align: right;
  display: flex;
  flex-direction: column;
  justify-content: center; /* 上下中央寄せ（不要なら消してOK） */
}

.chore-date-history {
  font-size: 14px;
  line-height: 1;          /* 行間を詰める */
}

.chore-time-history {
  font-size: 12px;
  line-height: 1;
  color: #777;
}

.chore-time {
  font-size: 15px;
  line-height: 1;
  color: #777;
}

.chore-actions {
  display: flex;          /* ← 必須 */
  align-items: center;    /* ← 縦中央 */
  justify-content: flex-end;
  gap: 8px;               /* アイコン間の余白 */
  margin-left: 18px;
}

.edit-link {
  text-decoration: none;
}

.delete-link {
  text-decoration: none;
}

/* フォーム＋エラーをまとめる箱 */
.form-wrapper {
  width: 360px;          /* 基準幅（重要） */
  max-width: 90%;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ボタン */
.actions {
  display: flex;
  justify-content: center;
  margin-top: 20px;
}

/* Devise エラーメッセージ */
#error_explanation {
  text-align: left;
}

#error_explanation ul {
  padding-left: 20px;
}

/* フィールド */
.field {
  display: flex;
  flex-direction: column;
  padding-bottom: 16px;
}

.field.remember-me {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
}

/* Devise エラーメッセージ */
#error_explanation {
  text-align: left;
}

#error_explanation ul {
  padding-left: 20px;
}

.content.selectorjoin {
  display: flex;
  flex-direction: column; /* 縦並び */
  align-items: center;
  justify-content: flex-start;
  padding-top: 40px;
  gap: 16px;
}

.header-logo {
  display: flex;
  align-items: center;
}

.logo-image {
  height: 30px;
  width: auto;
  margin: 0px 0;   /* ← 上下余白 */
}

.hidden-calendar-input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
  height: 0;
  width: 0;
}

.cake-icon {
  width: 24px;
  height: auto;
}

/* 標準の file input を非表示 */
.hidden-file {
  display: none;
}

/* ファイル選択ボタン */
#avatar_button {
  cursor: pointer;
  padding: 4px 10px;      /* ボタンの大きさ */
  font-size: 12px;          /* ボタン文字の大きさ */
  background-color: #ebe8e8; /* お好みの背景色 */
  border: 1px solid #555;
  border-radius: 6px;
  text-align: center;
}

/* ファイル名表示 */
#avatar_filename {
  font-size: 12px;          /* 文字の大きさ */
  color: #555;              /* 文字色 */
  min-height: 1em;          /* 選択されていないときも高さを確保 */
}

.user-avatar {
  width: 37px;
  height: 37px;
  border-radius: 50%; /* 丸くする */
  object-fit: cover;  /* はみ出さない */
  align-items: center; /* 縦中央揃え */
}

/* アイコンを横並びにする親要素 */
.chore-users-history {
  width: 89px;
  display: flex;
  justify-content: flex-end;   /* ← 右詰め */
  gap: 4px;                    /* アイコン間の隙間 */
  align-items: center;         /* 縦中央揃え */
  box-sizing: border-box;      /* ← paddingを幅に含める */
}

/* アイコン自体 */
.user-avatar-history {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  object-fit: cover;
  line-height: 1;
  margin: 0;
  display: inline-block;
}

.avatar-preview {
  width: 80px;
  height: 80px;
  border-radius: 4px;
}

.header-profile {
  display: flex;
  align-items: center;
  gap: 6px;
}

.fixed-bottom-right {
  position: fixed;
  right: 40px;
  bottom: 80px;
  display: flex;
  gap: 12px;          /* ボタン間の隙間 */
  align-items: center;
}

.fixed-bottom-left {
  position: fixed;
  left: 40px;
  bottom: 80px;
  display: flex;
  gap: 12px;          /* ボタン間の隙間 */
  align-items: center;
  background-color: #e0e0e0;
}

.fixed-link {
  width: 110px;
  appearance: none;
  -webkit-appearance: none;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  height: 50px;
  padding: 0 10px;

  border-radius: 5px;

  font-size: 15px;
  font-weight: 500;
  font-family: inherit;
  line-height: 1;

  border: 1px solid #535353;   /* ← 枠線を明示 */
  color: #000000;

  text-decoration: none;
  box-sizing: border-box;

  box-shadow: 0 16px 13px -12px rgba(0, 0, 0, -19.44), 0 4px 25px 0px rgba(0, 0, 0, 0.12), 0 8px 10px -5px rgba(0, 0, 0, 0.2);
}

.hidden {
  display: none;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
}

.modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}

/* モーダル全体の箱 */
.modal-content {
  position: relative;
  background: #ffffff;
  border: 1px solid #535353;   /* ← 枠線を明示 */
  width: 230px;
  padding-top: 25px;
  padding-bottom: 5px;
  margin: 100px auto;      /* 画面中央に配置 */
  border-radius: 8px;

  display: flex;
  flex-direction: column; /* 中身を縦並び */
  align-items: center;    /* 中身を横方向中央寄せ */
  text-align: center;
  color: #000000;
  font-weight: normal;
}

/* タイトル＋詳細 横並び */
.modal-title-area {
  display: flex;
  align-items: center;   /* 縦中央揃え */
  justify-content: center; /* 横中央揃え */
}

/* タイトル */
.modal-chore-title {
  font-size: 15px;
  font-weight: 500;
  font-weight: bold;
  margin: 0;      /* 余計なズレ防止 */
  line-height: 1;
  display: flex;
}

/* 詳細アイコン */
.detail-icon {
  width: 18px;
  height: 18px;
  display: block;  /* 下の余白を消す */
  cursor: pointer;
}

#complete-form {
  margin: 0;
}

.member-select {
  position: relative;
  width: 170px;
  padding-top: 20px;
}

/* 上のボックス */
.member-select-header {
  background: #d1d1d165;
  border: 1px solid #2e2e2e;
  padding: 5px 7px;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 下の一覧 */
.member-select-dropdown {
  position: absolute;
  top: 100%;
  box-sizing: border-box;
  width: 100%;
  background: #ffffff;
  border: 1px solid #a5a5a59a;
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  max-height: 180px;   /* ← 高さ固定 */
  overflow-y: auto;    /* ← スクロール */
  display: none;
}

.member-checkbox {
  display: block;
  padding: 8px 8px;
  border-bottom: 1px solid #c7c7c7;
  cursor: pointer;
}

.member-checkbox:last-child {
  border-bottom: none;
}

.member-checkbox:hover {
  background: #f5f5f5;
}

/* ボタン全体 */
.modal-buttons {
  display: flex;
  flex-direction: column; 
  align-items: stretch;   /* ← 中身を横幅いっぱいに伸ばす */
  width: 100%;         /* モーダル幅いっぱい */
  padding-top: 20px;
  padding-bottom: 4px;
}

.modal-buttons-gain {
  display: flex;
  flex-direction: column; 
  align-items: stretch;   /* ← 中身を横幅いっぱいに伸ばす */
  width: 100%;         /* モーダル幅いっぱい */
}

/* 1行目：完了ボタンを横いっぱいに */
.modal-buttons-complete button {
  width: 100%;            /* 親に合わせて横いっぱい */
  margin: 0px;
  padding: 3px 0;
  border-radius: 4px;
  box-sizing: border-box; /* パディング込みで幅いっぱい */
  background-color: #57587e;
  color: #ffffff;
}

/* ボタン全体 */
.modal-buttons-sub {
  display: flex;
  flex-direction: column; 
  align-items: stretch;   /* ← 中身を横幅いっぱいに伸ばす */ 
  width: 100%;         /* モーダル幅いっぱい */
}

.modal-buttons-reschedule button {
  width: 100%;            /* 親に合わせて横いっぱい */
  margin: 0px;
  padding: 3px 64px;
  border-radius: 4px;
  box-sizing: border-box; /* パディング込みで幅いっぱい */
  border: 1px solid #000000;
  background: #e9e9e9f8;
  color: #000000;
}

.hidden-calendar-input-reschedule {
  position: absolute;
  opacity: 0;
  pointer-events: none;
  height: 0;
  width: 0;
}

/* =========================
   削除アイコン（左上）
========================= */
#modal-delete {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 10;
}

.delete-icon {
  width: 20px;
  height: 20px;
  cursor: pointer;
}

/* ==============================
   reward専用
================================ */

/* タイトル（choreと同じ見た目） */
.modal-reward-title {
  font-size: 15px;
  font-weight: 500;
  font-weight: bold;
  margin: 0;
  padding-bottom: 8px;
}

/* コスト表示 */
.reward-cost {
  display: flex;
  flex-direction: column;  /* ← 縦並びにする */
  align-items: center;
  gap: 4px;
  font-size: 14px;
}

.reward-cost-value {
  display: flex;
  align-items: center;
  gap: 4px;
  padding-bottom: 15px;
}

/* ケーキアイコン */
.reward-cake-icon {
  width: 24px;
  height: 24px;
  display: block;
}

.member-tabs {
  display: flex;
  margin-bottom: 16px;
  padding: 6px 12px;
  background: #ffffffdc;
  text-decoration: none;
  border-radius: 8px;
}

.member-tab.active {
  background: #3030304b;
}

.member-tabs::-webkit-scrollbar {
  display: none;
}

.user-avatar-achievement {
  width: 34px;
  height: 34px;
  padding: 6px 6px;
  border-radius: 50%;
  object-fit: cover;
  line-height: 1;
  margin: 0;
  display: inline-block;
}

.achievement-panel {
  position: relative;
  margin-bottom: 30px;
  padding: 16px;
  width: 400px;
}

/* 上下ライン */
.achievement-panel::before,
.achievement-panel::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 85%;
  height: 2px;
  background: linear-gradient(
    to right,
    transparent,
    #c9a94f,
    #e6d18a,
    #c9a94f,
    transparent
  );
  z-index: 1;
}

.achievement-panel::before {
  top: 0;
}

.achievement-panel::after {
  bottom: 0;
}

/* 装飾 */
.achievement-panel .top-decor,
.achievement-panel .bottom-decor {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #c9a94f;
  font-size: 14px;
  background: #fff;
  padding: 0 8px;
  z-index: 2;
}

.achievement-panel .top-decor {
  top: -8px;
}

.achievement-panel .bottom-decor {
  bottom: -8px;
}

.cake-display {
  display: flex;
  flex-direction: column; /* 縦並び */
  gap: 4px;
}

.cake-row {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}

.cake-icon {
  height: auto;
  width: 35px;
}

.cake-multiple-icon {
  width: 40px;
  height: 40px;
  margin-top: 50px;
}

.cake-number {
  display: flex;
}

.cake-number-icon {
  width: 48px;
  height: 100px;
  margin-top: 6px;
  margin-left: 3px;
}

.reward-cake-icon.whole {
  width: 40px;
  align-items: center;
}

.reward-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;

  margin-top: 40px;
  margin-bottom: 30px;

  position: relative;
}

.reward-box {
  width: 420px;
  height: 130px;
  padding: 14px 40px;

  box-sizing: border-box; /* ← これが肝 */
  display: flex;
  justify-content: space-between;
  align-items: center;

  color: #ffffff;


  background-image: url("<%= asset_path 'thankyou.jpg' %>"); /* 画像パス */
  background-size: cover;
  background-position: center;

  border-radius: 12px;
  border: 1px solid #e0e0e0;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
}

/* 左側 */
.reward-left {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.reward-title {
  font-size: 19px;
  font-weight: 700;
  padding-bottom: 8px;
}

.reward-need {
  font-size: 14px;
  color: #ffffff;
}

/* 右側 */
.reward-right {
  display: flex;
  align-items: center;
}

/* 丸表示 */
.reward-circle {
  width: 70px;
  height: 70px;
  border-radius: 50%;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  font-size: 14px;
  font-weight: 600;
  text-align: center;
}

/* 未達成 */
.reward-circle.ng {
  background: #fff3f3;
  color: #e05353;
  border: 2px solid #d32f2f;
  font-size: 12px;
  font-weight: 600;
}

/* 達成 */
.reward-circle.ok {
  background: #f0ffe4;
  color: #3b3a3a;
  border: 2px solid #6f9165;
}

/* 「達成まで」だけ黒文字 */
.reward-circle.ng .reward-label {
  color: #000000;
  font-size: 12px;
  font-weight: normal;
}

.cake-count {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-weight: bold;
}

.mini-cake-reward {
  height: 30px;
}

.detail-edit-link {
  display: inline-flex;   /* ← 中の詳細・編集を中央揃え */
  align-items: center;
  text-decoration: none;
}

.detail-icon,
.edit-icon,
.delete-icon {
  width: 17px;
  height: auto;
}

.detail-icon-home {
  width: 16px;
  height: 16px;
  display: block;
  padding-top: 4px;
}

.edit-icon-reward {
  width: 16px;
  height: 16px;
  display: block;
  padding-bottom: 5px;
}

.icon-separator {
  font-size: 14px;
  line-height: 1;         /* 文字の縦ズレ防止 */
}

.cake-wrapper {
  position: relative;
  display: inline-block;
}

.cake-icon.whole {
  width: 200px;
  padding-left: 15px;
}

.cake-info {
  position: absolute;
  background: #fff;
  width: 90px;
  height: 90px;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 13px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  text-align: center;
}

.cake-info.top-right {
  top: 20px;
  right: 40px;
}

.cake-info .number {
  font-weight: bold;
  color: #e74c3c; /* 赤系でケーキ感 */
}

.cake-count-plain {
  position: absolute;
  bottom: 10px;
  right: 25px;
  display: flex;
  flex-direction: column; /* 縦並び */
  align-items: flex-end;  /* 右寄せ */
  gap: 4px;
  font-size: 14px;
  color: #333;
}

.cake-count-label {
  font-size: 13px;
}

.cake-count-body {
  display: flex;
  align-items: center;
  gap: 6px;
}

.mini-cake {
  width: 28px;
  height: auto;
}

.cake-count-body .count {
  font-weight: bold;
}

.form-wrapper-chore {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30px 0;
}

.form-card {
  background: #ffffff;
  width: 420px;                /* 少し広げる */
  padding: 36px 32px;
  border-radius: 12px;         /* 角丸を少し大きく */
  border: 1px solid #dcdfe3;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06); /* うっすら影 */
}

.form-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 28px;
  padding-bottom: 12px;
  border-bottom: 1px solid #e5e7eb;
  color: #333;
}

/* グループ間余白を増やす */
.form-group {
  margin-bottom: 26px;
}

.form-label {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #6b7280; /* 少し薄く */
  letter-spacing: 0.05em;
}

.required {
  display: inline-block;
  margin-left: 6px;
  padding: 1px 6px;
  font-size: 10px;
  color: #c62828;
  background: #fdecea;
  border-radius: 4px;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 9px 10px;
  border-radius: 4px;
  border: 1px solid #cfd3d8;
  background: #ffffff;
  font-size: 14px;
  box-sizing: border-box;   /* ← これを追加 */
}

.form-input:focus,
.form-textarea:focus {
  outline: none;
  border-color: #5b7dbd;
}

.form-input::placeholder,
.form-textarea::placeholder {
  color: #9aa0a6;
}

/* show専用の表示フィールド */
/* 表示フィールド */
.display-field {
  background-color: #f9fafb;
  padding: 12px 14px;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
  font-size: 15px;
  color: #111827;
  pointer-events: none;
}

/* textarea表示用 */
.form-textarea.display-field {
  min-height: 110px;
  line-height: 1.6;
}

.calendar-btn {
  width: 100%;
  padding: 9px 10px;
  border-radius: 4px;
  border: 1px solid #cfd3d8;
  background: #ffffff;
  font-size: 14px;
  color: #333;
  cursor: pointer;
  text-align: left;
}

.calendar-btn:hover {
  background: #f3f4f6;
}

.form-actions {
  margin-top: 30px;
  display: flex;
  justify-content: space-between; /* ← 左右に分ける */
  align-items: center;
}

.form-actions-show {
  display: flex;
  justify-content: flex-end;  /* ← これに変更 */
}

.submit-btn {
  padding: 12px 34px;  /* 横幅はpaddingで調整 */
  border-radius: 6px;
  border: none;
  background: #f3b769;
  color: #313131;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.submit-btn:hover {
  opacity: 0.9;
}

.back-link {
  display: inline-block;
  padding: 12px 14px;   /* width削除 */
  border-radius: 6px;
  border: 1px solid #d1d5db;
  background: #ffffff;
  font-size: 14px;
  color: #374151;
  text-decoration: none;
  transition: all 0.2s ease;
}

.back-link:hover {
  background: #f3f4f6;
}

/* 外側の箱 */
.home-links-box {
  position: fixed;       /* ← 位置固定 */
  bottom: 80px;          /* 下からの距離 */
  left: 50%;
  transform: translateX(-50%);  /* 中央寄せ */

  width: 300px;

  display: flex;
  flex-direction: column;
  gap: 12px;             /* ← ボタン間の隙間 */
}

/* 各ボタン */
.home-link-item {
  display: flex;
  align-items: center;      /* 縦中央 */
  justify-content: center;  /* 横中央 */

  padding: 14px 18px;
  background-color: #f3b769;
  border-radius: 6px;

  text-decoration: none;
  color: #303030;
}

/* テキスト */
.link-text {
  font-size: 16px;
  font-weight: 500;
  margin-right: 10px;
}

/* 右の丸 */
.link-arrow {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 22px;
  height: 22px;
  border-radius: 50%;

  background-color: #f1f1f1;
  color: rgb(54, 54, 54);

  font-size: 14px;
  font-weight: bold;
  line-height: 1;
}

.chore-create-btn {
  position: fixed;      /* 画面固定 */
  right: 40px;          /* 右から */
  bottom: 70px;         /* 下から */

  width: 60px;
  height: 60px;
  border-radius: 50%;

  background-color: #f3b769;
  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 28px;
  font-weight: bold;
  text-decoration: none;

  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  transition: transform 0.2s, box-shadow 0.2s;
}
