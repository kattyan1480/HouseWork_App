}

.secondary-btn:hover {
  opacity: 0.9;
}

.selection-title-user {
  display: flex;
  align-items: center;   /* 縦中央揃え */
  gap: 12px;
  margin-bottom: 14px;
}

.selection-title {
  display: flex;
  align-items: center;   /* 縦中央揃え */
  gap: 12px;
  margin-bottom: 14px;
  margin-top: 40px;
}

.form-selection-title {
  font-size: 30px;
  font-weight: bold;
  color: #333;
  margin: 0;   /* ← 余計なズレ防止 */
}

.file-name {
  margin-top: 8px;
  font-size: 30px;
  color: #666;
}

/* =========================
   サイドメニュー本体
========================= */
.side-menu {
  position: fixed;
  top: 0;
  left: -510px;
  width: 500px;
  height: 100%;
  background: #1e1f23;   /* 暗め背景 */
  box-shadow: 4px 0 15px rgba(0,0,0,0.4);
  transition: left 0.3s ease;
  z-index: 1001;
  padding-top: 60px;   /* 上に余白 */
}

/* 開いた状態 */
.side-menu.active {
  left: 0;
}

/* =========================
   メニューリンク
========================= */
.side-menu a {
  display: flex;              /* ← 横並びにする */
  align-items: center;
  padding: 16px 22px;
  text-decoration: none;
  color: #dcdcdc;
  font-size: 30px;
  font-weight: 500;
  transition: 0.2s;
  border-radius: 8px;
  margin: 6px 12px;
}

/* アイコン部分 */
.menu-icon {
  margin-right: 30px;
  width: 26px;               /* 揃える */
  text-align: center;
}

.menu-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
}

.menu-avatar-square {
  width: 40px;
  height: 40px;
  object-fit: cover;
}

/* hover時 */
.side-menu a:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #ffffff;
}

/* ログアウトを少し目立たせる */
.side-menu a:last-child {
  margin-top: 20px;
  border-top: 1px solid rgba(255,255,255,0.08);
  padding-top: 20px;
}

/* =========================
   オーバーレイ
========================= */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(2px);
  display: none;
  z-index: 1000;
}

.overlay.active {
  display: block;
}

/* =========================
   ハンバーガー強調
========================= */
.hamburger {
  cursor: pointer;
}

.hamburger .footer-icon {
  font-size: 40px;
}

.category-wrapper {
  padding: 30px;
  max-width: 1000px;
  margin: 0 auto;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30px;
  width: 290px;       /* 必要に応じて */
  margin-left: auto;  /* 右寄せ */
}

.category-add-btn {
  background: #f3b769;
  color: #333;
  padding: 12px 20px;
  border-radius: 8px;
  text-decoration: none;
  font-size: 30px;
  font-weight: 600;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 260px);
  gap: 20px;
}

.category-card {
  width: 250px;
  height: 200px;
  position: relative;
  background: #ffffff;
  border-radius: 16px;
  padding: 25px 10px;
  text-align: center;
  text-decoration: none;
  color: #333;
  box-shadow: 0 4px 10px rgba(0,0,0,0.08);
  transition: 0.2s ease;
}

.category-icon {
  width: 124px;
  height: 124px;
  margin: 0 auto 12px;

  border-radius: 50%;          /* 丸くする */
  border: 2px solid #e0e0e0;   /* 外枠 */
  background: #fff;            /* 背景を白に */
  
  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;            /* はみ出し防止 */
}

.category-icon img {
  max-width: 95%;     /* ← 少し小さめでスタンプ感 */
  max-height: 95%;
  object-fit: contain; /* 切らずに収める */
}

.category-name {
  font-size: 30px;
  font-weight: 600;
  padding: 4px 8px;
  border-radius: 8px;
  display: inline-block;
}

.category-empty {
  text-align: center;
  margin-top: 40px;
  color: #777;
}

.card-main-link {
  display: block;
  text-decoration: none;
  color: inherit;
}

.color-options {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.color-choice {
  position: relative;
  cursor: pointer;
}

.color-choice input {
  position: absolute;
  opacity: 0;
}

.color-circle {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid #ddd;
  display: inline-block;
  transition: 0.1s;
}

/* 選択時 */
.color-choice input:checked + .color-circle {
  border: 2px solid #7389c5;
  transform: scale(1.1);
}

.header-title-with-icon {
  display: flex;
  align-items: center;
  gap: 6px;
}

.header-icon {
  width: 50px;
  height: 50px;
}