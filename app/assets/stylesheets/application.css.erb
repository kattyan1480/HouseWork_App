/* 共通 */
.flash-message {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  padding: 16px 0;
  text-align: center;
  font-weight: bold;
  z-index: 9999;

  transform: translateY(-100%);
  opacity: 0;
  transition: all 0.5s ease;
}

/* 表示状態 */
.flash-show { 
  transform: translateY(0); 
  opacity: 1; }

/* 成功 */
.flash-notice {
  background-color: #d4edda;
  color: #1e8035;
}

/* 失敗 */
.flash-alert {
  background-color: #f8d7da;
  color: #a02632;
}

